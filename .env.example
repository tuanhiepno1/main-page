# Landing page — Vite environment variables
# Copy to .env.local (dev) or .env.production (production build).
# All variables must be prefixed with VITE_ to be exposed to client code.

# Ticket System public API endpoint
VITE_API_BASE_URL=http://127.0.0.1:5555/api/public

# Must match PUBLIC_API_KEY in Ticket System's .env
VITE_API_KEY=

# Admin portal credentials (frontend-only basic auth)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=
